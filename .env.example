# WDOS Local Development Configuration
# Copy this file to .env or use the provided run_local.ps1 / run_local.bat runner

# Python UTF-8 encoding (strongly recommended on Windows)
PYTHONUTF8=1

# Django debug mode (1 for local development, 0 for production/staging)
DJANGO_DEBUG=1

# Allowed hosts for local development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local development secret key
DJANGO_SECRET_KEY=wdos-local-development-only

# Port for local development server (8000 is often in use; 8080 or 8008 recommended)
PORT=8080

# Local origin URL (used for links, redirects, and origins)
WDOS_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Secure cookies flag: Set to 0 for local HTTP testing so session/CSRF cookies work over http://
WDOS_SECURE_COOKIES=0

# Database URL: Leave blank to use local SQLite (db.sqlite3), or provide a PostgreSQL connection URL
# e.g.: postgresql://postgres:postgres@127.0.0.1:5432/wdos
DATABASE_URL=
DB_SSLMODE=disable

# Email / Brevo configuration (optional for local development)
WDOS_BREVO_API_KEY=
WDOS_EMAIL_FROM=noreply@example.org

# Stage 3 Onboarding Policy (JSON):
# Required for testing the full onboarding flow; fails closed if omitted.
WDOS_ONBOARDING_POLICY_JSON={"version":"local-dev-v1","approval_reference":"LOCAL-DEV-APPROVAL","privacy_notice":"Local development privacy notice for testing WDOS.","review_role":"reviewer","review_function":"onboarding","eligibility":[{"code":"adult","label":"Adult Member","network":"WGMN","basis":"Self attestation"},{"code":"youth","label":"Youth Member","network":"WNNN","basis":"Self attestation"}],"homes":[{"code":"chapter-1","label":"Lagos Chapter (Ikeja)","network":"WGMN","country":"Nigeria","region":"Lagos","district":"Ikeja","kind":"chapter"},{"code":"chapter-2","label":"Lagos Chapter (Surulere)","network":"WGMN","country":"Nigeria","region":"Lagos","district":"Surulere","kind":"chapter"},{"code":"chapter-3","label":"Abuja Chapter (AMAC)","network":"WGMN","country":"Nigeria","region":"FCT","district":"Abuja Municipal","kind":"chapter"},{"code":"chapter-4","label":"Rivers Chapter (Port Harcourt)","network":"WGMN","country":"Nigeria","region":"Rivers","district":"Port Harcourt","kind":"chapter"},{"code":"chapter-5","label":"Lagos Youth Chapter (Ikeja)","network":"WNNN","country":"Nigeria","region":"Lagos","district":"Ikeja","kind":"chapter"},{"code":"chapter-6","label":"Abuja Youth Chapter (Bwari)","network":"WNNN","country":"Nigeria","region":"FCT","district":"Bwari","kind":"chapter"},{"code":"chapter-7","label":"Kano Youth Chapter (Nasarawa)","network":"WNNN","country":"Nigeria","region":"Kano","district":"Nasarawa","kind":"chapter"}]}
